; Tech Adventure - an original mobile-first tycoon prototype
config_version=5

[application]
config/name="Tech Adventure"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="A colorful angled-view mobile tech-shop tycoon"
config/icon="res://icon.png"

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

anti_aliasing/quality/msaa_2d=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.88, 0.96, 0.97, 1)

[input_devices]
pointing/emulate_mouse_from_touch=false
